# Base URL of the flashcards backend API.
# Read at build time by scripts/generate-env-config.mjs, which writes
# public/env-config.js. That file prefills the "API" field on flashcards.html.
# When empty or missing, the page falls back to the current origin and the
# field stays editable so the URL can be entered by hand.
NEXT_PUBLIC_API_URL=https://dev-api-ai-flashcards.toondemy.com